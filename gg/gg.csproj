<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>1.8.8</Version>
		<Authors>Gabbon3</Authors>
		<Company>Torino</Company>
		<Product>GgCLI</Product>
		<Description>CLI general purpose</Description>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PublishAot>true</PublishAot>
		<PublishDir>c:\tesisquare\tools</PublishDir>

		<StripSymbols>true</StripSymbols>
		<ConsoleFullSymbolStackTraces>false</ConsoleFullSymbolStackTraces>
		<StackTraceSupport>false</StackTraceSupport>
		<InvariantGlobalization>true</InvariantGlobalization>

		<OptimizationPreference>Size</OptimizationPreference>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="plugins\mdconverter\assets\md.min.css" />
		<None Remove="plugins\mdconverter\assets\md.scss" />
	</ItemGroup>

	<Target Name="CompileSass" BeforeTargets="BeforeBuild;PrepareForBuild">
		<Message Importance="high" Text="[Gg] Compilazione Sass in corso..." />
		<Exec Command="sass plugins\mdconverter\assets\md.scss:plugins\mdconverter\assets\md.min.css --style compressed --no-source-map" />
	</Target>

	<Target Name="PublishRelease">
		<CallTarget Targets="CompileSass" />
		<Message Importance="high" Text="[Gg] Avvio Pubblicazione Native AOT in corso..." />

		<Exec Command="dotnet publish -c Release -r win-x64 --self-contained true --nologo -v:m -p:WarningLevel=0 -clp:NoSummary" />

		<Message Importance="high" Text="[Gg] Missile AOT pronto in: $(PublishDir)" />
	</Target>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Spectre.Console" Version="0.55.2" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
	</ItemGroup>

</Project>